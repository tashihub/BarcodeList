<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarcodeList.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BarcodeList.Views"
    Title="BarcodeList">

    <TabBar>
        <ShellContent
            Title="スキャン"
            ContentTemplate="{DataTemplate local:BarcodeReaderView}"
            Route="MainPage" />
        <ShellContent
            Title="作成"
            ContentTemplate="{DataTemplate local:BarcodeCreateMenuView}"
            Route="CreatePage" />
        <ShellContent
            Title="履歴フォルダ"
            ContentTemplate="{DataTemplate local:FolderView}"
            Route="FolderPage" />
    </TabBar>
</Shell>
