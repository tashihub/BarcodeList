<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarcodeList.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BarcodeList.Views"
    xmlns:strings="clr-namespace:BarcodeList.Resources.Strings;assembly=BarcodeList.Core"
    Title="BarcodeList">

    <TabBar>
        <ShellContent
            Title="{x:Static strings:AppResources.Tab_Create}"
            ContentTemplate="{DataTemplate local:BarcodeCreateMenuView}"
            Icon="create.png"
            Route="CreatePage" />
        <ShellContent
            Title="{x:Static strings:AppResources.Tab_Scan}"
            ContentTemplate="{DataTemplate local:BarcodeReaderView}"
            Icon="scan.png"
            Route="MainPage" />
        <ShellContent
            Title="{x:Static strings:AppResources.Tab_Folder}"
            ContentTemplate="{DataTemplate local:FolderView}"
            Icon="folder.png"
            Route="FolderPage" />
        <ShellContent
            Title="{x:Static strings:AppResources.Tab_History}"
            ContentTemplate="{DataTemplate local:HistoryView}"
            Icon="history.png"
            Route="HistoryPage" />
        <ShellContent
            Title="{x:Static strings:AppResources.Tab_Settings}"
            ContentTemplate="{DataTemplate local:SettingsView}"
            Icon="setting.png"
            Route="SettingsPage" />
    </TabBar>
</Shell>
