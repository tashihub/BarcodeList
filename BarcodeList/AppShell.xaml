<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarcodeList.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BarcodeList.Views"
    Title="BarcodeList">

    <TabBar>
        <ShellContent
            Title="作成"
            ContentTemplate="{DataTemplate local:BarcodeCreateMenuView}"
            Icon="create.png"
            Route="CreatePage" />
        <ShellContent
            Title="スキャン"
            ContentTemplate="{DataTemplate local:BarcodeReaderView}"
            Icon="scan.png"
            Route="MainPage" />
        <ShellContent
            Title="フォルダ"
            ContentTemplate="{DataTemplate local:FolderView}"
            Icon="folder.png"
            Route="FolderPage" />
        <ShellContent
            Title="履歴"
            ContentTemplate="{DataTemplate local:HistoryView}"
            Icon="history.png"
            Route="HistoryPage" />
    </TabBar>
</Shell>
