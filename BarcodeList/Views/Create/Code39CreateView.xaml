<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarcodeList.Views.Create.Code39CreateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Code39作成"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="Code39作成"
                FontSize="28"
                FontAttributes="Bold" />

            <Border Style="{StaticResource CardBorderStyle}">


                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="バーコード値"
                        FontSize="14"
                        TextColor="Gray" />

                    <Entry
                        Placeholder="例：ABC123456"
                        Text="{Binding BarcodeValue}" />

                    <Label
                        Text="英数字・記号が使用できます。業務用バーコードでよく使われます。"
                        FontSize="12"
                        TextColor="Gray" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="Red"
                        IsVisible="{Binding HasError}" />

                </VerticalStackLayout>
            </Border>

            <Button
                Style="{StaticResource CreateButtonStyle}"
                Command="{Binding CreateCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>