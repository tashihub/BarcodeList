<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarcodeList.Views.Create.Gs1128CreateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tool="clr-namespace:BarcodeList.Tool"
    Title="GS1-128作成"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="GS1-128作成"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="AIコード(2〜4桁)と値を1つずつ追加してください。どのAIコードでも追加できます。"
                FontSize="13"
                TextColor="Gray" />

            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="AI要素を追加"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <Label
                        Text="AIコード"
                        FontSize="13"
                        TextColor="Gray" />

                    <Entry
                        Placeholder="例：01"
                        Keyboard="Numeric"
                        MaxLength="4"
                        Text="{Binding NewAiCode}" />

                    <Label
                        Text="{Binding NewAiNameHint}"
                        FontSize="12"
                        TextColor="#4F46E5" />

                    <Label
                        Text="値"
                        FontSize="13"
                        TextColor="Gray" />

                    <Entry
                        Placeholder="例：14971032310685"
                        Keyboard="{Binding NewAiValueKeyboard}"
                        MaxLength="{Binding NewAiValueMaxLength}"
                        Text="{Binding NewAiValue}" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="Red"
                        IsVisible="{Binding HasError}" />

                    <Button
                        Text="＋ リストに追加"
                        Command="{Binding AddElementCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#4F46E5" />

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" IsVisible="{Binding HasElements}">
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="追加したAI要素"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding Elements}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="tool:Gs1Element">
                                <Grid
                                    Padding="0,6"
                                    ColumnDefinitions="60,*,Auto"
                                    ColumnSpacing="8">

                                    <Label
                                        Text="{Binding Ai}"
                                        FontAttributes="Bold"
                                        TextColor="#4F46E5"
                                        VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Name}" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding Value}" FontSize="16" LineBreakMode="CharacterWrap" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="2"
                                        Text="削除"
                                        FontSize="12"
                                        Padding="10,4"
                                        BackgroundColor="Transparent"
                                        TextColor="Red"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveElementCommand}"
                                        CommandParameter="{Binding .}" />

                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <Button
                Style="{StaticResource CreateButtonStyle}"
                Command="{Binding CreateCommand}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="対応AIコード一覧"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <Label
                        Text="下記以外のAIコードも作成はできますが、このアプリで読み返したときの内訳表示は保証されません。"
                        FontSize="12"
                        TextColor="Gray" />

                    <CollectionView ItemsSource="{Binding KnownAiReference}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="tool:Gs1AiReferenceItem">
                                <Grid
                                    Padding="0,4"
                                    ColumnDefinitions="60,*"
                                    ColumnSpacing="8">

                                    <Label
                                        Text="{Binding Ai}"
                                        FontAttributes="Bold"
                                        TextColor="#4F46E5" />

                                    <Label
                                        Grid.Column="1"
                                        FontSize="13">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Name}" />
                                                <Span Text=" ・ " TextColor="Gray" />
                                                <Span Text="{Binding FormatHint}" TextColor="Gray" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
