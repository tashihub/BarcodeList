<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarcodeList.Views.Create.Code128CreateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    Title="Code128作成"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="Code128作成"
                FontSize="28"
                FontAttributes="Bold" />

            <!-- データ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="バーコード値"
                        FontSize="14"
                        TextColor="Gray" />
                    <Editor
                        Text="{Binding Code128Value}"
                        Placeholder="ABC123"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="100" />
                    <Label
                        Text="英数字・記号が使用できます。日本語を使う場合はQRコードを選択してください。"
                        FontSize="12"
                        TextColor="Gray" />
                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="Red"
                        IsVisible="{Binding HasError}" />
                </VerticalStackLayout>
            </Border>

            <Button
                Command="{Binding CreateCommand}"
                Style="{StaticResource CreateButtonStyle}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>