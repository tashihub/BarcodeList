<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarcodeList.Views.Create.BarcodeCreateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:BarcodeList.Resources.Strings;assembly=BarcodeList.Core"
    Title="{Binding Title}"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="{Binding Title}"
                FontSize="28"
                FontAttributes="Bold" />

            <Border Style="{StaticResource CardBorderStyle}" IsVisible="{Binding ShowFormatPicker}">
                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="{x:Static strings:AppResources.Create_TypeLabel}"
                        FontSize="13"
                        TextColor="Gray" />

                    <Picker
                        ItemsSource="{Binding Formats}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedFormat}" />

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="{x:Static strings:AppResources.Create_ValueLabel}"
                        FontSize="13"
                        TextColor="Gray" />

                    <Entry
                        x:Name="valueEntry"
                        Placeholder="{Binding Placeholder}"
                        Keyboard="{Binding Keyboard}"
                        MaxLength="{Binding EntryMaxLength}"
                        Text="{Binding InputValue}" />

                    <Label
                        Text="{Binding FormatHint}"
                        FontSize="12"
                        TextColor="#4F46E5" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="Red"
                        IsVisible="{Binding HasError}" />

                </VerticalStackLayout>
            </Border>

            <Button
                Style="{StaticResource CreateButtonStyle}"
                Clicked="OnCreateClicked"
                Command="{Binding CreateCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
