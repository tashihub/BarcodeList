<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarcodeList.Views.Create.QrCreateView"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
             BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}"
             Title="QrCreateView">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="QRコード作成"
                FontSize="28"
                FontAttributes="Bold" />


            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="QRコード内容" FontSize="14" TextColor="Gray" />

                    <Editor
                        Placeholder="URLやテキストを入力してください"
                        Text="{Binding QrValue}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="120" />
                </VerticalStackLayout>
            </Border>


            <Button
                Style="{StaticResource CreateButtonStyle}"
                Command="{Binding CreateCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>