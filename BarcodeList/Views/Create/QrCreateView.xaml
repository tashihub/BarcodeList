<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarcodeList.Views.Create.QrCreateView"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
             BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}"
             Title="QrCreateView">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="QRコード作成"
                FontSize="28"
                FontAttributes="Bold" />

            <!--<Border Padding="18" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">
                    <Label Text="名称" FontSize="14" TextColor="Gray" />

                    <Entry
                        Placeholder="例：会社URL / テスト用QR"
                        Text="{Binding Title}" />
                </VerticalStackLayout>
            </Border>-->

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">
                    <Label Text="QRコード内容" FontSize="14" TextColor="Gray" />

                    <Editor
                        Placeholder="URLやテキストを入力してください"
                        Text="{Binding QrValue}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="120" />
                </VerticalStackLayout>
            </Border>

            <!--<Border
                IsVisible="{Binding HasQrValue}"
                Padding="22"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label
                        Text="プレビュー"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <zxing:BarcodeGeneratorView
                        Value="{Binding QrValue}"
                        Format="QrCode"
                        WidthRequest="260"
                        HeightRequest="260" />
                </VerticalStackLayout>
            </Border>-->

            <Button
                Text="作成"
                Command="{Binding CreateCommand}"
                HeightRequest="52"
                CornerRadius="16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>