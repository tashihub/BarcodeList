<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarcodeList.Views.FolderView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="フォルダ"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">



    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="18">

        <VerticalStackLayout Spacing="4">
            <Label
                Text="フォルダ"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="保存したバーコードをフォルダ別に表示します"
                FontSize="13"
                TextColor="Gray" />
        </VerticalStackLayout>

        <Button
            Grid.Row="1"
            Text="＋ 新しいフォルダを作成"
            Command="{Binding CreateFolderCommand}"
            Style="{StaticResource SaveButtonStyle}" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Folders}"
            SelectionMode="None"
            EmptyView="フォルダがありません">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem
                        Text="削除"
                        BackgroundColor="#E53935"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteFolderCommand}"
                        CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border
                Style="{StaticResource CardResultBorderStyle}"
                Margin="0,0,0,12">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenFolderCommand}"
                        CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                <Border
                        WidthRequest="52"
                        HeightRequest="52"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#25253A}">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Label
                            Text="📁"
                            FontSize="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Label
                            Text="{Binding Name}"
                            FontSize="16"
                            FontAttributes="Bold" />

                                    <Label
                            Text="{Binding CreatedAtText}"
                            FontSize="12"
                            TextColor="Gray" />
                                </VerticalStackLayout>

                                <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="28"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>