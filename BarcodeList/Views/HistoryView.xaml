<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarcodeList.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:BarcodeList.Resources.Strings;assembly=BarcodeList.Core"
    Padding="20"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.History_DeleteAllToolbar}" IconImageSource="trash.png" Command="{Binding DeleteAllCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView
        ItemsSource="{Binding Histories}"
        SelectionMode="None"
        EmptyView="{x:Static strings:AppResources.History_EmptyView}">

        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <Label
                FontAttributes="Bold"
                Text="{x:Static strings:AppResources.History_Description}"
                FontSize="Medium"
                TextColor="Gray"
                Margin="0,0,0,18" />
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate>

                <SwipeView>
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Reveal">
                            <SwipeItem
                                Text="{x:Static strings:AppResources.Common_Delete}"
                                BackgroundColor="#E53935"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Border
                        Style="{StaticResource CardResultBorderStyle}">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenHistoryCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                            <Border
                                WidthRequest="52"
                                HeightRequest="52"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#25253A}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label
                                    Text="{Binding BarcodeTypeIcon}"
                                    FontSize="22"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label
                                    Text="{Binding BarcodeType}"
                                    FontSize="16"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding BarcodeValue}"
                                    FontSize="14"
                                    TextColor="Gray"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Text="{Binding CreatedAtText}"
                                    FontSize="12"
                                    TextColor="Gray" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="28"
                                TextColor="Gray"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </SwipeView>

            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
