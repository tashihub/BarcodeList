<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarcodeList.Views.Details.FolderDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:BarcodeList.Resources.Strings"
    Title="{x:Static strings:AppResources.FolderDetail_Title}"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">


    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="18">

        <VerticalStackLayout Spacing="4">
            <Label
                Text="{Binding Folder.Name}"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="{x:Static strings:AppResources.FolderDetail_Description}"
                FontSize="13"
                TextColor="Gray" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Barcodes}"
            SelectionMode="None"
            EmptyView="{x:Static strings:AppResources.FolderDetail_EmptyView}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <SwipeView>

                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem
                        Text="{x:Static strings:AppResources.Common_Delete}"
                        BackgroundColor="#E53935"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteBarcodeCommand}"
                        CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border
                Style="{StaticResource CardResultBorderStyle}"
                Margin="0,0,0,12">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenBarcodeCommand}"
                        CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                <Border
                        WidthRequest="52"
                        HeightRequest="52"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#25253A}">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <!--<Label
                            Text="{Binding BarcodeTypeIcon}"
                            FontSize="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />-->

                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="5">

                                    <Label
                            Text="{Binding BarcodeType}"
                            FontSize="16"
                            FontAttributes="Bold" />

                                    <Label
                            Text="{Binding BarcodeValue}"
                            FontSize="14"
                            TextColor="Gray"
                            LineBreakMode="TailTruncation" />

                                    <Label
                            Text="{Binding CreatedAtText}"
                            FontSize="12"
                            TextColor="Gray" />

                                </VerticalStackLayout>

                                <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="28"
                        TextColor="Gray"
                        VerticalOptions="Center" />

                            </Grid>
                        </Border>

                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>