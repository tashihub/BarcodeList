<ContentPage
    x:Class="BarcodeList.Views.BarcodeCreateMenuView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cs="clr-namespace:BarcodeList.Services.CreateServices"
    xmlns:strings="clr-namespace:BarcodeList.Resources.Strings;assembly=BarcodeList.Core"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Label
                Text="{x:Static strings:AppResources.CreateMenu_Description}"
                FontSize="Medium"
                TextColor="Gray" />

            <VerticalStackLayout Spacing="10">

                <!-- GS1-128(AI要素の入力が必要なため専用画面。他と同じ見た目で並べる) -->
                <Border
                    Padding="16,14"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenGs1128CreateCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{x:Static strings:AppResources.CreateMenu_Gs1Title}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{x:Static strings:AppResources.CreateMenu_Gs1Subtitle}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1" Text="›" FontSize="26" TextColor="Gray" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- フォーマットごとのメニュー項目(BarcodeFormatCatalogから自動生成) -->
                <CollectionView ItemsSource="{Binding Formats}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="cs:BarcodeFormatDefinition">
                            <Border
                                Padding="16,14"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenFormatCreateCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding FormatHint}" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="›" FontSize="26" TextColor="Gray" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
