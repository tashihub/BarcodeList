<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarcodeList.Views.Result.Gs1128ResultView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tool="clr-namespace:BarcodeList.Tool"
    Title="GS1-128結果"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="GS1-128結果"
                FontSize="28"
                FontAttributes="Bold" />

            <!-- プレビュー -->
            <Border Style="{StaticResource CardResultBorderStyle}">
                <VerticalStackLayout Spacing="16">
                    <Label
                        Text="プレビュー"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <GraphicsView
                        x:Name="gs1GraphicsView"
                        HeightRequest="140"
                        HorizontalOptions="Fill"
                        BackgroundColor="White" />

                </VerticalStackLayout>
            </Border>

            <!-- AIコード -->
            <Border Style="{StaticResource CardResultBorderStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="AIコード"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding Elements}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="tool:Gs1Element">
                                <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" RowSpacing="4" Padding="0,6">
                                    <Label
                                        Grid.RowSpan="2"
                                        Text="{Binding Ai}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="#4F46E5" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Name}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding Value}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        LineBreakMode="CharacterWrap" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <!-- 生データ -->
            <Border Style="{StaticResource CardResultBorderStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="生データ"
                        FontSize="13"
                        TextColor="Gray" />

                    <Label
                        Text="{Binding Gs1Value}"
                        FontSize="18"
                        FontAttributes="Bold"
                        LineBreakMode="CharacterWrap" />

                    <Label
                        Text="形式：GS1-128 / Code128"
                        FontSize="12"
                        TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <!-- 保存先フォルダ -->
            <Border Style="{StaticResource CardResultBorderStyle}">

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="保存先フォルダ"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <Picker
                        Title="フォルダを選択"
                        ItemsSource="{Binding Folders}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedFolder}" />

                    <Button
                        Text="＋ 新しいフォルダを作成"
                        Command="{Binding CreateFolderCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#4F46E5" />
                </VerticalStackLayout>
            </Border>

            <Button
                Text="このGS1-128を保存"
                Command="{Binding SaveCommand}"
                Style="{StaticResource SaveButtonStyle}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
