<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarcodeList.Views.Result.BarcodeResultView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    xmlns:strings="clr-namespace:BarcodeList.Resources.Strings"
    Title="{x:Static strings:AppResources.Result_DefaultTitle}"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="{Binding DisplayName, StringFormat={x:Static strings:AppResources.Result_TitleFormat}}"
                FontSize="28"
                FontAttributes="Bold" />

            <!-- プレビュー -->
            <Border Style="{StaticResource CardResultBorderStyle}">
                <VerticalStackLayout Spacing="16">
                    <Label
                        Text="{x:Static strings:AppResources.Result_Preview}"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <zxing:BarcodeGeneratorView
                        Value="{Binding BarcodeValue}"
                        Format="{Binding Format}"
                        HeightRequest="140"
                        HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- 生データ -->
            <Border Style="{StaticResource CardResultBorderStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="{x:Static strings:AppResources.Result_RawData}"
                        FontSize="13"
                        TextColor="Gray" />

                    <Label
                        Text="{Binding BarcodeValue}"
                        FontSize="18"
                        FontAttributes="Bold"
                        LineBreakMode="CharacterWrap">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding IsWebUrl}"
                                Value="True">

                                <Setter Property="TextColor" Value="Blue" />
                                <Setter Property="TextDecorations" Value="Underline" />

                            </DataTrigger>
                        </Label.Triggers>

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenWebUrlCommand}" />
                        </Label.GestureRecognizers>

                    </Label>

                    <Label
                        Text="{Binding DisplayName, StringFormat={x:Static strings:AppResources.Result_FormatLabelFormat}}"
                        FontSize="12"
                        TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <!-- 保存先フォルダ -->
            <Border Style="{StaticResource CardResultBorderStyle}">

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{x:Static strings:AppResources.Result_SaveFolderLabel}"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <Picker
                        Title="{x:Static strings:AppResources.Common_SelectFolderPickerTitle}"
                        ItemsSource="{Binding Folders}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedFolder}" />

                    <Button
                        Text="{x:Static strings:AppResources.Common_AddNewFolderButton}"
                        Command="{Binding CreateFolderCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#4F46E5" />
                </VerticalStackLayout>
            </Border>

            <Button
                Text="{x:Static strings:AppResources.Result_SaveButton}"
                Command="{Binding SaveCommand}"
                Style="{StaticResource SaveButtonStyle}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
