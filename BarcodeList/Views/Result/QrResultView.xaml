<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarcodeList.Views.Result.QrResultView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    Title="QRコード結果"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="QRコード結果"
                FontSize="28"
                FontAttributes="Bold" />

            <!-- QRプレビュー -->
            <Border
                Padding="22"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label
                        Text="プレビュー"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <zxing:BarcodeGeneratorView
                        Value="{Binding QrValue}"
                        Format="QrCode"
                        WidthRequest="260"
                        HeightRequest="260" />
                </VerticalStackLayout>
            </Border>

            <!-- 生データ -->
            <Border
                Padding="18"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="生データ"
                        FontSize="13"
                        TextColor="Gray" />

                    <Label
                        Text="{Binding QrValue}"
                        FontSize="18"
                        FontAttributes="Bold"
                        LineBreakMode="CharacterWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- 保存先フォルダ -->
            <Border
                Padding="18"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="保存先フォルダ"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <Picker
                        Title="フォルダを選択"
                        ItemsSource="{Binding Folders}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedFolder}" />

                    <Button
                        Text="＋ 新しいフォルダを作成"
                        Command="{Binding CreateFolderCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#4F46E5" />
                </VerticalStackLayout>
            </Border>

            <Button
                Text="このQRコードを保存"
                Command="{Binding SaveCommand}"
                HeightRequest="52"
                CornerRadius="16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>